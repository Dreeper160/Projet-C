if [ $# -eq 1  ] || [ $# -ge 3 ]  || ( [ $# -eq 2 ] && [ $1 != "-k" ] )
then
	echo ""
	echo "Usage : $0 [-k KEY_ID]"
	echo ""
	echo "OPTION"
	echo "    -k KEY_ID"
	echo "        Précise une clé pour la signature des paquets."
	exit 1
fi
if [ $# -eq 2 ]
then
	key="-k$2"
else
	key=''
fi
rm -rf mlv-2.0.2*
rm -rf mlv_2.0.2*
rm -rf libmlv_2.0.2*
rm -rf libmlv-dev_2.0.2*
(cd ../.. && make dist) && cp ../../mlv-2.0.2.tar.gz . && tar -xzf mlv-2.0.2.tar.gz && cp -r debian mlv-2.0.2 && cd mlv-2.0.2/ && dpkg-buildpackage $key -rfakeroot && cd .. && rm -rf mlv-2.0.2.tar.gz mlv-2.0.2 
